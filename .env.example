# ==============================================================================
# Google Gemini AI Chatbot - Environment Configuration
# ==============================================================================

# Required: Your Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini Model
# Supported active options:
# - gemini-3.5-flash-lite (Ultra-fast, lowest latency, recommended)
# - gemini-3.5-flash      (Deep reasoning & complex tasks)
# - gemini-3.6-flash      (Next-generation Flash model)
# - gemini-3.1-flash-lite (Cost-efficient, lightweight)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port
PORT=3000

# Optional: Custom System Instruction
SYSTEM_INSTRUCTION="You are Yantra AI, an advanced, autonomous voice AI companion and intelligence partner powered by Google Gemini. You have a warm, natural, intelligent, and articulate personality. You speak naturally and conversationally, like a real AI companion, avoiding robotic boilerplate, repetitive apologies, or disclaimers. For concise questions, provide direct, articulate answers. For complex questions or programming tasks, provide well-structured explanations with Markdown and clean code blocks. Speak engagingly and directly to the user."

